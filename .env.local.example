# -----------------------------------------------------------------------------
# Supabase
# Get from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Payment Gateways
# -----------------------------------------------------------------------------
# eSewa — https://esewa.com.np/developer
ESEWA_MERCHANT_CODE=your-merchant-code
ESEWA_SECRET_KEY=your-secret-key
NEXT_PUBLIC_ESEWA_GATEWAY_URL=https://example.com/ebanking/checkout

# Khalti — https://khalti.com/developer
KHALTI_SECRET_KEY=your-secret-key
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=your-public-key

# FonePay — https://fonepay.com.np/developer
FONEPAY_MERCHANT_CODE=your-merchant-code
FONEPAY_SECRET=your-secret

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000